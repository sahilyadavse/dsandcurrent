legend {
    text-transform: capitalize !important;
    font-size: 16px !important;
    letter-spacing: 0 !IMPORTANT;
    border-bottom: 0px !important;
}






























.dsand-calc-btn .elementor-button-text{

    animation: dsandGlow 1.2s infinite !important;

}

@keyframes dsandGlow{

0%{

color:#fff;

text-shadow:none;

}

50%{

color:#FFD700;

text-shadow:
0 0 8px #FFD700,
0 0 16px #FFD700,
0 0 24px #FFD700;

}

100%{

color:#fff;

text-shadow:none;

}

}

.dsand-calc-btn{

animation:btnPulse 1.5s infinite;

}

@keyframes btnPulse{

0%{

transform:scale(1);

}

50%{

transform:scale(1.07);

}

100%{

transform:scale(1);

}

