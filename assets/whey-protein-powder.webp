		<div class="elementor-element elementor-element-38ed88f e-con-full e-flex wpr-particle-no wpr-jarallax-no wpr-parallax-no wpr-sticky-section-no wpr-column-slider-no wpr-equal-height-no e-con e-child" data-id="38ed88f" data-element_type="container" data-e-type="container">
				<div class="elementor-element elementor-element-a363560 elementor-widget elementor-widget-shortcode" data-id="a363560" data-element_type="widget" data-e-type="widget" data-widget_type="shortcode.default">
				<div class="elementor-widget-container">
							<div class="elementor-shortcode">
    <div class="lps-wrapper">
      <div class="lps-input-group">
        <input type="text" id="lpsInput" class="lps-input" placeholder="Search products..." autocomplete="off">
        <button type="button" class="lps-btn" id="lpsBtn">SEARCH</button>
      </div>
      <div id="lpsResults" class="lps-results"></div>
    </div>

    <style>
    .lps-wrapper{
      position: relative;
      max-width: 500px;
      width: 100%;
      margin: 0 auto;
      font-family: inherit;
    }
    .lps-input-group{
      display: flex;
      width: 100%;
      border-radius: 6px;
      overflow: hidden;
      box-shadow: 0 1px 4px rgba(0,0,0,0.08);
    }
    .lps-input{
      flex: 1 1 auto;
      padding: 10px 14px;
      border: 1px solid #ddd;
      border-right: none;
      font-size: 15px;
      outline: none;
      min-width: 0;
    }
    .lps-input:focus{
      border-color: #7a1fa2;
    }
    .lps-btn{
      flex: 0 0 auto;
      background: #7a1fa2;
      color: #fff;
      border: none;
      padding: 0 20px;
      font-weight: 600;
      letter-spacing: 0.5px;
      cursor: pointer;
      font-size: 14px;
      white-space: nowrap;
    }
    .lps-btn:hover{
      background: #611980;
    }
    .lps-results{
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: #fff;
      border: 1px solid #eee;
      border-top: none;
      max-height: 420px;
      overflow-y: auto;
      z-index: 9999;
      box-shadow: 0 8px 20px rgba(0,0,0,0.12);
      border-radius: 0 0 6px 6px;
    }
    .lps-item{
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 10px 14px;
      text-decoration: none;
      color: #222;
      border-bottom: 1px solid #f2f2f2;
      transition: background 0.15s ease;
    }
    .lps-item:last-child{
      border-bottom: none;
    }
    .lps-item:hover{
      background: #faf5fc;
    }
    .lps-item img{
      width: 48px;
      height: 48px;
      object-fit: cover;
      border-radius: 4px;
      flex-shrink: 0;
    }
    .lps-item-info{
      display: flex;
      flex-direction: column;
      gap: 2px;
      min-width: 0;
    }
    .lps-item-title{
      font-size: 14px;
      font-weight: 500;
      line-height: 1.3;
      white-space: normal;
    }
    .lps-item-price{
      font-size: 13px;
      color: #555;
    }
    .lps-item-price del{
      color: #999;
      margin-right: 5px;
    }
    .lps-item-price ins{
      text-decoration: none;
      color: #7a1fa2;
      font-weight: 600;
    }
    .lps-no-result, .lps-loading{
      padding: 14px;
      text-align: center;
      font-size: 14px;
      color: #777;
    }
    @media (max-width: 480px){
      .lps-btn{ padding: 0 14px; font-size: 12px; }
      .lps-input{ font-size: 14px; padding: 9px 10px; }
      .lps-item img{ width: 40px; height: 40px; }
      .lps-item-title{ font-size: 13px; }
    }
    </style>

    <script>
    (function(){
      var input      = document.getElementById('lpsInput');
      var resultsBox = document.getElementById('lpsResults');
      var btn        = document.getElementById('lpsBtn');
      var timer      = null;

      // Ab yeh PHP asli tarike se execute hoga (WPCode ke through) isliye admin_url() sahi kaam karega
      var ajaxUrl = "https://dsandnutrilabs.com/wp-admin/admin-ajax.php";

      function searchProducts(term){
        if(term.length < 2){
          resultsBox.style.display = 'none';
          resultsBox.innerHTML = '';
          return;
        }

        resultsBox.style.display = 'block';
        resultsBox.innerHTML = '<div class="lps-loading">Searching...</div>';

        var formData = new FormData();
        formData.append('action', 'live_product_search');
        formData.append('term', term);

        fetch(ajaxUrl, {
          method: 'POST',
          body: formData
        })
        .then(function(res){ return res.json(); })
        .then(function(data){
          renderResults(data);
        })
        .catch(function(){
          resultsBox.innerHTML = '<div class="lps-no-result">Kuch error aa gaya, dobara try karein.</div>';
        });
      }

      function renderResults(items){
        if(!items || items.length === 0){
          resultsBox.innerHTML = '<div class="lps-no-result">Koi product nahi mila</div>';
          return;
        }

        var html = '';
        items.forEach(function(item){
          html += '<a href="' + item.link + '" class="lps-item">' +
                    '<img src="' + item.image + '" alt="">' +
                    '<div class="lps-item-info">' +
                      '<div class="lps-item-title">' + item.title + '</div>' +
                      '<div class="lps-item-price">' + item.price + '</div>' +
                    '</div>' +
                  '</a>';
        });
        resultsBox.innerHTML = html;
      }

      input.addEventListener('input', function(){
        var term = this.value.trim();
        clearTimeout(timer);
        timer = setTimeout(function(){
          searchProducts(term);
        }, 350);
      });

      btn.addEventListener('click', function(){
        searchProducts(input.value.trim());
      });

      document.addEventListener('click', function(e){
        if(!e.target.closest('.lps-wrapper')){
          resultsBox.style.display = 'none';
        }
      });
    })();
    </script>

    </div>
						</div>
				</div>
				</div>
