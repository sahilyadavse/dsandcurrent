/* DSAND — Fresh Brand Design */
:root{
  --ink:#0b1815;
  --ink-soft:#2a3a36;
  --ink-muted:#6b8078;
  --surface:#f7f5f0;
  --surface-dark:#0b1815;
  --accent:#1b4d35;
  --accent-bright:#2e7d52;
  --cream:#fdf9f0;
  --line:#e8e4dc;
  --font-head:"Instrument Serif", Georgia, serif;
  --font-body:"Inter", system-ui, sans-serif;
  --font-mono:"Space Grotesk", ui-monospace, monospace;
}

*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:var(--font-body);background:var(--cream);color:var(--ink);line-height:1.55;-webkit-font-smoothing:antialiased}
img{max-width:100%;height:auto;display:block}
a{color:inherit;text-decoration:none}

/* Header */
.site-header{position:sticky;top:0;z-index:100;background:rgba(253,249,240,.92);backdrop-filter:saturate(140%) blur(12px);border-bottom:1px solid var(--line)}
.header-inner{max-width:1280px;margin:0 auto;padding:18px 32px;display:flex;align-items:center;justify-content:space-between;gap:24px}
.logo{font-family:var(--font-head);font-size:26px;font-weight:400;letter-spacing:-.04em;color:var(--ink)}
.nav-main{display:flex;gap:28px;font-family:var(--font-body);font-size:13px;font-weight:500;letter-spacing:.02em;text-transform:uppercase}
.nav-main a{position:relative}
.nav-main a::after{content:'';position:absolute;bottom:-2px;left:0;width:0;height:1px;background:var(--accent);transition:width .25s}
.nav-main a:hover::after{width:100%}
.header-right{display:flex;align-items:center;gap:16px}
.btn-ghost{font-size:12px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;border:1px solid var(--ink);padding:6px 14px;border-radius:2px;transition:background .2s,color .2s}
.btn-ghost:hover{background:var(--ink);color:var(--cream)}
.menu-btn{display:none;background:none;border:none;cursor:pointer;width:28px;height:28px;position:relative}
.menu-btn span{display:block;height:1.5px;background:var(--ink);margin:5px 0;transition:.25s}

/mobile-nav{display:none;position:absolute;top:100%;left:0;right:0;background:var(--surface);border-bottom:1px solid var(--line);padding:24px 32px;flex-direction:column;gap:14px;font-family:var(--font-body);font-size:15px;font-weight:500}
.mobile-nav.open{display:flex}

/* Hero */
.hero{padding:96px 32px 80px;background:var(--cream);position:relative;overflow:hidden}
.hero-grid{max-width:1280px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:center}
.hero-text-col .eyebrow{font-family:var(--font-mono);font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--accent);margin-bottom:20px;display:inline-block}
.hero-text-col h1{font-family:var(--font-head);font-size:clamp(56px,7.5vw,108px);line-height:.88;letter-spacing:-.045em;color:var(--ink);margin-bottom:28px}
.hero-text-col h1 span{font-style:italic;color:var(--accent-soft);}
.hero-text-col .lead{font-size:18px;color:var(--ink-soft);line-height:1.45;max-width:440px;margin-bottom:36px}
.hero-cta .btn-primary{display:inline-block;font-family:var(--font-body);font-size:13px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;background:var(--ink);color:var(--cream);padding:14px 28px;border-radius:2px;transition:background .2s}
.hero-cta .btn-primary:hover{background:var(--accent)}

.hero-visual-col{position:relative;display:flex;justify-content:center;align-items:center}
.hero-product-cluster{position:relative;width:420px;height:420px}
.cluster-item{position:absolute;width:240px;height:240px;object-fit:cover;border-radius:4px;box-shadow:0 32px 80px rgba(11,24,21,.15)}
.cluster-item.back{left:0;top:40px;z-index:1;transform:rotate(-4deg)}
.cluster-item.mid{left:110px;top:10px;z-index:2;transform:rotate(2deg)}
.cluster-item.front{right:0;top:30px;z-index:3;transform:rotate(-3deg)}

/* Feature */
.feature-product{background:var(--surface);padding:120px 32px}
.feature-inner{max-width:1280px;margin:0 auto;display:grid;grid-template-columns:1.1fr .9fr;gap:64px;align-items:center}
.feature-image{position:relative}
.feature-image img{width:100%;border-radius:4px;box-shadow:0 40px 100px rgba(11,24,21,.12)}
.feature-badge{position:absolute;top:24px;left:24px;background:var(--ink);color:#fff;font-family:var(--font-mono);font-size:10px;letter-spacing:.12em;text-transform:uppercase;padding:6px 14px;border-radius:2px}
.feature-label{font-family:var(--font-mono);font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--accent);margin-bottom:14px}
.feature-body h2{font-family:var(--font-head);font-size:clamp(36px,4.5vw,72px);line-height:.92;letter-spacing:-.035em;margin-bottom:22px}
.feature-body .feature-desc{font-size:17px;color:var(--ink-soft);line-height:1.55;max-width:420px;margin-bottom:28px}
.link-arrow{font-family:var(--font-body);font-size:14px;font-weight:600;border-bottom:1.5px solid var(--ink);padding-bottom:3px;transition:border-color .2s}
.link-arrow:hover{border-color:var(--accent)}

/* Lineup */
.lineup{padding:120px 32px;background:var(--cream)}
.lineup-header{max-width:1280px;margin:0 auto 64px}
.lineup-header h2{font-family:var(--font-head);font-size:clamp(40px,5vw,72px);line-height:.92;letter-spacing:-.035em;margin-bottom:16px}
.lineup-header p{font-size:17px;color:var(--ink-soft);max-width:400px}
.lineup-grid{max-width:1280px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:24px}
.lineup-card{display:block;background:var(--surface);border:1px solid var(--line);border-radius:2px;padding:0;transition:transform .2s,border-color .2s}
.lineup-card:hover{transform:translateY(-4px);border-color:var(--accent)}
.card-visual{aspect-ratio:4/3;overflow:hidden}
.card-visual img{width:100%;height:100%;object-fit:cover;transition:transform .5s}
.lineup-card:hover .card-visual img{transform:scale(1.04)}
.card-text{padding:24px 24px 28px}
.card-text h3{font-family:var(--font-head);font-size:22px;letter-spacing:-.02em;margin-bottom:8px}
.card-text p{font-size:14px;color:var(--ink-soft);line-height:1.45}
.lineup-card.large{grid-column:span 2}
.lineup-card.large .card-visual{aspect-ratio:16/9}
.lineup-card.large .card-text h3{font-size:32px}

/* Day */
.day{padding:120px 32px;background:var(--surface);position:relative}
.day-inner{max-width:1280px;margin:0 auto}
.day-inner>h2{font-family:var(--font-head);font-size:clamp(36px,4.5vw,72px);line-height:.92;letter-spacing:-.035em;margin-bottom:10px}
.subtitle{font-size:17px;color:var(--ink-soft);max-width:480px;margin-bottom:64px}
.timeline{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:28px}
.timeline-item{background:var(--cream);border:1px solid var(--line);border-radius:4px;padding:28px;border-top:3px solid var(--accent)}
.timeline-item .time{font-family:var(--font-mono);font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--accent);margin-bottom:14px}
.timeline-item img{width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:2px;margin-bottom:18px;box-shadow:0 8px 24px rgba(11,24,21,.08)}
.timeline-item h3{font-family:var(--font-head);font-size:22px;letter-spacing:-.02em;margin-bottom:8px}
.timeline-item p{font-size:14px;color:var(--ink-soft)}

/* Diff */
.diff{padding:120px 32px;background:var(--ink);color:#fff}
.diff-inner{max-width:1280px;margin:0 auto}
.diff-inner h2{font-family:var(--font-head);font-size:clamp(36px,5vw,72px);line-height:.92;letter-spacing:-.035em;margin-bottom:24px}
.diff-desc{font-size:18px;color:rgba(255,255,255,.7);max-width:560px;margin-bottom:60px;line-height:1.45}
.diff-gallery{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:20px}
.diff-gallery figure img{width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:4px;box-shadow:0 24px 48px rgba(0,0,0,.35)}
.diff-gallery figcaption{font-family:var(--font-mono);font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:rgba(255,255,255,.55);margin-top:12px}

/* Quality */
.quality{padding:120px 32px;background:var(--cream)}
.quality-inner{max-width:1280px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:start}
.quality-left h2{font-family:var(--font-head);font-size:clamp(36px,4vw,72px);line-height:.92;letter-spacing:-.035em;margin-bottom:16px}
.quality-left p{font-size:17px;color:var(--ink-soft);line-height:1.55}
.quality-right{background:var(--surface);border:1px solid var(--line);border-radius:4px;padding:32px}
.quality-list{display:grid;gap:24px}
.quality-list div{border-bottom:1px solid var(--line);padding-bottom:18px}
.quality-list dt{font-family:var(--font-mono);font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--accent);margin-bottom:6px}
.quality-list dd{font-size:14px;color:var(--ink-soft);line-height:1.45}

/* Journal */
.journal{padding:120px 32px;background:var(--surface)}
.journal-inner{max-width:1280px;margin:0 auto}
.journal-header{display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:48px;flex-wrap:wrap;gap:16px}
.journal-header h2{font-family:var(--font-head);font-size:clamp(32px,4vw,64px);line-height:.92;letter-spacing:-.035em}
.journal-grid{display:grid;grid-template-columns:2fr 1fr;gap:28px}
.journal-feature a img{width:100%;aspect-ratio:16/9;object-fit:cover;border-radius:4px;box-shadow:0 24px 60px rgba(11,24,21,.12);margin-bottom:24px;transition:transform .25s}
.journal-feature a:hover img{transform:scale(1.01)}
.journal-feature .journal-tag{font-family:var(--font-mono);font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--accent);margin-bottom:8px}
.journal-feature h3{font-family:var(--font-head);font-size:28px;letter-spacing:-.02em;margin-bottom:10px}
.journal-feature h3 a:hover{color:var(--accent)}
.journal-feature p{font-size:15px;color:var(--ink-soft);line-height:1.45}
.journal-secondary{display:flex;flex-direction:column;gap:24px}
.journal-secondary article{display:grid;grid-template-columns:100px 1fr;gap:16px;align-items:center}
.journal-secondary article img{width:100px;height:100px;object-fit:cover;border-radius:4px}
.journal-secondary article .journal-tag{font-family:var(--font-mono);font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:var(--accent);margin-bottom:6px}
.journal-secondary article h3{font-family:var(--font-head);font-size:18px;letter-spacing:-.02em}
.journal-secondary article h3 a:hover{color:var(--accent)}

/* Close CTA */
.close{padding:120px 32px;background:var(--ink);color:#fff;position:relative;overflow:hidden}
.close-inner{max-width:1280px;margin:0 auto;position:relative;z-index:2;max-width:560px}
.close-inner h2{font-family:var(--font-head);font-size:clamp(48px,7vw,110px);line-height:.88;letter-spacing:-.05em;margin-bottom:36px}
.close-inner .btn-primary{display:inline-block;background:#fff;color:var(--ink);font-family:var(--font-body);font-size:13px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;padding:14px 28px;border-radius:2px;transition:background .2s}
.close-inner .btn-primary:hover{background:var(--accent);color:#fff}
.close-composition{position:absolute;right:0;top:-20px;width:420px;height:300px;z-index:1;pointer-events:none}
.close-composition img{position:absolute;width:140px;height:140px;object-fit:cover;border-radius:4px;box-shadow:0 24px 60px rgba(0,0,0,.35)}
.close-composition img:nth-child(1){left:0;top:20px;transform:rotate(-4deg)}
.close-composition img:nth-child(2){left:140px;top:0;transform:rotate(3deg)}
.close-composition img:nth-child(3){left:280px;top:60px;transform:rotate(-2deg)}

/* Footer */
.site-footer{background:var(--ink);color:#fff;padding:80px 32px 28px}
.footer-inner{max-width:1280px;margin:0 auto;display:flex;justify-content:space-between;gap:48px;flex-wrap:wrap}
.footer-brand .logo{font-family:var(--font-head);font-size:28px;letter-spacing:-.04em;font-weight:400;margin-bottom:10px;display:block}
.footer-brand p{font-size:14px;color:rgba(255,255,255,.55);max-width:280px;line-height:1.45}
.footer-nav{display:flex;gap:80px;flex-wrap:wrap}
.footer-nav div{display:flex;flex-direction:column;gap:8px}
.footer-nav strong{font-family:var(--font-mono);font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:rgba(255,255,255,.5);margin-bottom:4px}
.footer-nav a{font-size:14px;color:rgba(255,255,255,.75);transition:color .2s}
.footer-nav a:hover{color:#fff}
.copyright{max-width:1280px;margin:48px auto 0;padding-top:20px;border-top:1px solid rgba(255,255,255,.1);font-size:12px;color:rgba(255,255,255,.3);letter-spacing:.05em}

/* Quick modal */
.overlay{position:fixed;inset:0;background:rgba(11,24,21,.25);z-index:200;opacity:0;pointer-events:none;transition:opacity .2s ease}
.overlay.show{opacity:1;pointer-events:auto}
.quick-modal{position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);background:#fff;padding:32px;border-radius:4px;z-index:210;max-width:420px;box-shadow:0 32px 80px rgba(11,24,21,.25);opacity:0;pointer-events:none;transition:opacity .2s}
.quick-modal.open{opacity:1;pointer-events:auto}
.quick-modal button{position:absolute;top:12px;right:12px;background:none;border:none;font-size:24px;cursor:pointer;color:var(--ink)}

/* Responsive */
@media(max-width:980px){
  .hero-grid{grid-template-columns:1fr}
  .cluster-item{width:180px;height:180px}
  .feature-inner{grid-template-columns:1fr}
  .lineup-card.large{grid-column:span 1}
  .quality-inner{grid-template-columns:1fr}
  .journal-grid{grid-template-columns:1fr}
  .close-composition{width:320px;height:220px;right:-20px}
  .close-composition img{width:100px;height:100px}
  .close-composition img:nth-child(1){left:0;top:10px}
  .close-composition img:nth-child(2){left:100px;top:0}
  .close-composition img:nth-child(3){left:200px;top:30px}
}
@media(max-width:640px){
  .nav-main{display:none}
  .menu-btn{display:block}
  .header-inner{padding:14px 20px}
  .hero{padding:60px 20px 60px}
  .lineup-grid{grid-template-columns:1fr}
  .timeline{grid-template-columns:1fr}
  .feature-product,.lineup,.day,.diff,.quality,.journal,.close{padding:80px 20px}
  .close-inner{max-width:100%}
}
